{
  "dataset": "UNSW-NB15 (BENIGN vs ATTACK)",
  "source": "UNSW_NB15_training-set.parquet + UNSW_NB15_testing-set.parquet",
  "rows": 60000,
  "features": 34,
  "classes": [
    "ATTACK",
    "BENIGN"
